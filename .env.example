NODE_ENV=development
HOST=127.0.0.1
PORT=4174
APP_ORIGIN=http://127.0.0.1:4174
DB_PATH=./data/orbit.sqlite
TRUST_PROXY=false
REGISTRATION_OPEN=true
# Email: none (disabled), file (local development only), resend (real delivery).
MAIL_DRIVER=none
MAIL_FROM=
RESEND_API_KEY=
ALLOW_LEGACY_REGISTRATION=false
# Optional links to YOUR published installers. Empty means unavailable.
DOWNLOAD_ANDROID=
DOWNLOAD_GOOGLEPLAY=
DOWNLOAD_WINDOWS=
DOWNLOAD_MACOS=
DOWNLOAD_LINUX=
DOWNLOAD_IOS=
APP_LINK=
# VPN bridge: implement the contract in docs/INTEGRATIONS.md for your panel.
VPN_BRIDGE_URL=
VPN_BRIDGE_TOKEN=
# Checkout is intentionally disabled until a payment adapter is implemented.
# For Docker deployment with a real domain:
# DOMAIN=vpn.your-domain.ru
# ACME_EMAIL=you@your-domain.ru
