{
  "name": "herbis-website",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.14 <25" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --env-file-if-exists=.env --watch server/index.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "admin": "node --env-file-if-exists=.env scripts/admin.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs"
  }
}
